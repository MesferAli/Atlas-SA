DB_DSN="atlasdb_high"
DB_WALLET_PATH="/home/ubuntu/atlas_wallet"

# OCI Generative AI
OCI_GENAI_ENDPOINT="https://inference.generativeai.me-riyadh-1.oci.oraclecloud.com"
