OCI_GENAI_MODEL_ID="cohere.command-r-plus"

# Oracle Fusion Integration
FUSION_BASE_URL="https://fa-etid-saasfaprod1.fa.ocs.oraclecloud.com"
FUSION_USER="mesfer@xcyrcle.co"
FUSION_PASSWORD="AtlasMZX#2026Secure!"

# Oracle E-Business Suite Integration
# ATLAS_SOURCE_SYSTEM = FUSION | EBS  (which sync package the scheduler runs)
# EBS_INTEGRATION_MODE = DBLINK | ISG (DBLINK is the default; ISG = REST via Integrated SOA Gateway)
ATLAS_SOURCE_SYSTEM="FUSION"
EBS_INTEGRATION_MODE="DBLINK"
EBS_DB_LINK="EBS_PROD"
EBS_APPS_SCHEMA="APPS"
EBS_BUSINESS_GROUP_ID="0"
EBS_LEDGER_ID="0"
EBS_ORG_ID="0"
# Only used when EBS_INTEGRATION_MODE=ISG
EBS_ISG_BASE_URL=""
EBS_ISG_USER=""
EBS_ISG_PASSWORD=""

# OCI API Gateway
API_GATEWAY_ENDPOINT="https://jpopcryemdv3rdlu4j63tmd5cm.apigateway.me-riyadh-1.oci.customer-oci.com/atlas/v1"

# Other Settings
LOG_LEVEL="INFO"
